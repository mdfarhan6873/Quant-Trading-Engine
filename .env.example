# ==============================================================================
# JINI AI Quant Trading Engine - Environment Configuration Template
# Copy this file to `.env` and fill in your credentials. NEVER commit `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Brain API Keys (Configure AT LEAST ONE — Free Tiers Supported!)
# ------------------------------------------------------------------------------
# [FREE TIER RECOMMENDED] TokenRouter (https://www.tokenrouter.com/console/token)
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017-free
TOKENROUTER_FALLBACK_MODEL=

# [FREE TIER RECOMMENDED] Groq (https://console.groq.com/keys) - key starts with gsk_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [FREE TIER RECOMMENDED] Google AI Studio Gemini (https://aistudio.google.com/apikey)
# IMPORTANT: Standard Gemini API keys start with "AIza..."
GEMINI_API_KEY=

# [FREE TIER MODELS] OpenRouter (https://openrouter.ai/keys) - key starts with sk-or-v1-
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# [FREE TIER] Cerebras Inference (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# [100% FREE LOCAL LLM] Ollama (https://ollama.com - no API key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# [PAID OPTIONAL] Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Minimum LLM confidence % required for PAPER entries (LIVE mode enforces >=90%)
LLM_MIN_CONFIDENCE=78

# ------------------------------------------------------------------------------
# 2. Broker & Real-Time WebSocket Feeds
# ------------------------------------------------------------------------------
# Upstox OAuth (Generate daily token via `python upstox_auth.py`)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/callback
UPSTOX_ACCESS_TOKEN=

# Shoonya / Finvasia (Optional for live execution & NFO feed)
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# Groww Trading API (Optional for live order execution)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. Macro, News & Infrastructure
# ------------------------------------------------------------------------------
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Capital & Risk Guardrails (INR)
MAX_CAPITAL=50000
MAX_DAILY_LOSS=5000
MAX_CONSECUTIVE_LOSSES=3
TRADING_MODE=PAPER
